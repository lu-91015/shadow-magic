# PostgreSQL 连接串（必填）。本地示例：
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/lidousha
# 托管版（Supabase / Neon 等）通常已含 ssl，脚本会自动启用。
DATABASE_URL=

# 拉取李豆沙动态所需（从浏览器登录 B站后复制 Cookie 中的 SESSDATA）
# 方式一：仅填 SESSDATA（URL 编码原样粘贴）
BILI_SESSDATA=
# 方式二：直接粘贴整段 Cookie 字符串（更稳妥，含 bili_ticket 等）
BILI_COOKIE=

# ===== 后台鉴权（必填，生产环境必须修改默认值） =====
# 管理员密码：用于登录后台并执行增删改操作。默认值 'admin' 极弱，生产务必改为强密码。
ADMIN_PASSWORD=
# 游客密码：仅可查看/查询，不能增删改。默认值 'guest'；若留空则禁止游客访问。
GUEST_PASSWORD=
# 会话签名密钥（HMAC-SHA256）：默认回退到 ADMIN_PASSWORD。建议单独设置一段随机长字符串，
# 例如：openssl rand -hex 32
ADMIN_SECRET=

